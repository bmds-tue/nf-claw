# --- superpowers (plans, scratch, skill state) — KEEP LOCAL, NEVER UPLOAD ---
superpowers/
.superpowers/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage*
htmlcov/
/build/
/dist/
.ruff_cache/
.venv/
venv/
.env

# --- macOS ---
.DS_Store

# --- Nextflow / pipeline runs (never commit run artifacts) ---
.nextflow/
.nextflow.log*
work/
results/
# What a documented `--outdir results` run leaves beside it: its replay, a previous run preserved by
# --resume, and the writer locks.
results.replay/
results.previous-*/
.*.nfclaw.lock

# The Nextflow launcher, if installed into the repo root (`curl -s https://get.nextflow.io | bash`).
# It is a local tool, never part of the library — anchored so pipeline sources are unaffected.
/nextflow

# per-version cache: materialized worktrees + on-demand docs for non-pinned releases and dev commits
pipelines/*/.versions/

# git worktrees (parallel agents)
.worktrees/
