          "fasta": {
            "anyOf": [
              {
                "format": "file-path",
                "pattern": "^\\S+\\.(fa|fasta)(\\.gz)?$",
                "type": "string"
              },
              {
                "pattern": "^[^\\s./]+$",
                "type": "string"
              }
            ]
          },
          "group": {
            "meta": [
              "id"
            ],
            "pattern": "^\\S+$",
            "type": "string"
          },
          "gtf": {
            "format": "file-path",
            "pattern": "^\\S+\\.gtf(\\.gz)?$",
            "type": "string"
          },
          "input_file": {
            "format": "path",
            "type": "string"
          },
          "replicate": {
            "minimum": 1,
            "pattern": "^\\d+$",
            "type": "integer"
          }
        },
        "required": [
          "group",
          "replicate"
        ]
      }
    },
