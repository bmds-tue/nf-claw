params.input = 'https://raw.githubusercontent.com/nf-core/test-datasets/bactmap/samplesheet.csv'
params.reference = 'https://raw.githubusercontent.com/nf-core/test-datasets/bactmap/genome/NCTC13799.fna'
params.trim = true
params.save_trimmed_fail = false
params.adapter_file = '/mnt/volume/nfclaw-remediation-evidence-20261026/bactmap-managed-probe-20261028-v2/staging/nfclaw-check-09cfvou7/pipeline/assets/adapters.fas'
params.subsampling_off = false
params.subsampling_depth_cutoff = 100
params.genome_size = false
params.remove_recombination = true
params.non_GATC_threshold = 0.5
params.rapidnj = true
params.fasttree = true
params.iqtree = true
params.raxmlng = true
params.multiqc_config = null
params.multiqc_title = null
params.outdir = './results'
params.tracedir = './results/pipeline_info'
params.publish_dir_mode = 'copy'
params.email = null
params.email_on_fail = null
params.plaintext_email = false
params.max_multiqc_email_size = '25.MB'
params.skip_multiqc = false
params.enable_conda = false
params.validate_params = true
params.show_hidden_params = false
params.schema_ignore_params = 'modules'
params.monochrome_logs = false
params.help = false
params.singularity_pull_docker_container = false
params.custom_config_version = 'master'
params.custom_config_base = 'https://raw.githubusercontent.com/nf-core/configs/master'
params.hostnames = []
params.config_profile_description = null
params.config_profile_contact = null
params.config_profile_url = null
params.max_memory = '2.GB'
params.max_cpus = 2
params.max_time = '1.h'
params.modules.fastp.args = '--cut_front --cut_tail --trim_poly_x --cut_mean_quality 30 --qualified_quality_phred 30 --unqualified_percent_limit 10 --length_required 50'
params.modules.fastp.publish_files = [json:'', html:'', log:'log']
params.modules.mash_sketch.args = '-k 32 -m 3'
params.modules.rasusa.args = '--seed 23032021'
params.modules.bwa_index.args = ''
params.modules.bwa_mem.args = ''
params.modules.bwa_mem.args2 = '-F 4'
params.modules.bwa_mem.publish_files = false
params.modules.samtools_sort.args = ''
params.modules.samtools_sort.suffix = '.sorted'
params.modules.samtools_index.args = ''
params.modules.bam_stats.args = ''
params.modules.bcftools_mpileup.args = '--min-BQ 20 --annotate FORMAT/AD,FORMAT/ADF,FORMAT/ADR,FORMAT/DP,FORMAT/SP,INFO/AD,INFO/ADF,INFO/ADR'
params.modules.bcftools_mpileup.args2 = '--ploidy 1 --multiallelic-caller'
params.modules.bcftools_mpileup.args3 = ''
params.modules.bcftools_mpileup.publish_files = [gz:'', 'gz.tbi':'', 'stats.txt':'']
params.modules.bcftools_mpileup.publish_dir = 'variants'
params.modules.bcftools_filter.args = '--soft-filter LowQual --exclude \'%QUAL<25 || FORMAT/DP<1 || MQ<30 || MQ0F>0.1\' --output-type z'
params.modules.bcftools_filter.suffix = '.filtered'
params.modules.bcftools_filter.publish_dir = 'variants'
params.modules.gubbins.args = '-v -t hybrid'
params.modules.snpsites.args = ''
params.modules.vcf2pseudogenome.publish_dir = 'pseudogenomes'
params.modules.alignpseudogenomes.publish_dir = 'pseudogenomes'
params.modules.alignpseudogenomes.non_GATC_threshold = 0.8
params.modules.rapidnj.args = '-t d -b 1000 -n'
params.modules.rapidnj.publish_dir = 'rapidnj'
params.modules.fasttree.args = '-gtr -gamma -fastest'
params.modules.fasttree.publish_dir = 'fasttree'
params.modules.iqtree.args = '-alrt 1000 -B 1000 -m MFP -czb'
params.modules.iqtree.publish_dir = 'iqtree'
params.modules.raxmlng.args = '--all --model GTR+G --bs-trees 1000'
params.modules.raxmlng.publish_dir = 'raxmlng'
params.modules.multiqc.args = ''
params.modules.multiqc.publish_files = [_data:'', html:'']
params.modules.multiqc.publish_dir = 'multiqc'
process.cpus = { check_max( 1 , 'cpus'   ) }
process.memory = { check_max( 1.GB * task.attempt, 'memory' ) }
process.time = { check_max( 4.h  * task.attempt, 'time'   ) }
process.errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
process.maxRetries = 1
process.maxErrors = '-1'
process.'withLabel:process_low'.cpus = { check_max( 1     * task.attempt, 'cpus'   ) }
process.'withLabel:process_low'.memory = { check_max( 1.GB * task.attempt, 'memory' ) }
process.'withLabel:process_low'.time = { check_max( 1.h   * task.attempt, 'time'   ) }
process.'withLabel:process_medium'.cpus = { check_max( 2     * task.attempt, 'cpus'   ) }
process.'withLabel:process_medium'.memory = { check_max( 2.GB * task.attempt, 'memory' ) }
process.'withLabel:process_medium'.time = { check_max( 2.h   * task.attempt, 'time'   ) }
process.'withLabel:process_high'.cpus = { check_max( 4    * task.attempt, 'cpus'   ) }
process.'withLabel:process_high'.memory = { check_max( 4.GB * task.attempt, 'memory' ) }
process.'withLabel:process_high'.time = { check_max( 4.h  * task.attempt, 'time'   ) }
process.'withLabel:process_long'.time = { check_max( 12.h  * task.attempt, 'time'   ) }
process.'withLabel:error_ignore'.errorStrategy = 'ignore'
process.'withLabel:error_retry'.errorStrategy = 'retry'
process.'withLabel:error_retry'.maxRetries = 2
process.'withName:BWA_INDEX'.cpus = { check_max( 1     * task.attempt, 'cpus'   ) }
process.'withName:BWA_INDEX'.memory = { check_max( 1.GB * task.attempt, 'memory'  ) }
process.'withName:BWA_INDEX'.time = { check_max( 4.h   * task.attempt, 'time'   ) }
process.'withName:SAMTOOLS_SORT'.cpus = { check_max( 1     * task.attempt, 'cpus'   ) }
process.'withName:SAMTOOLS_SORT'.memory = { check_max( 1.GB * task.attempt, 'memory'  ) }
process.'withName:SAMTOOLS_SORT'.time = { check_max( 1.h   * task.attempt, 'time'   ) }
process.shell = ['/bin/bash', '-euo', 'pipefail']
env.PYTHONNOUSERSITE = 1
env.R_PROFILE_USER = '/.Rprofile'
env.R_ENVIRON_USER = '/.Renviron'
timeline.enabled = true
timeline.file = './results/pipeline_info/execution_timeline_2026-10-28_04-38-27.html'
report.enabled = true
report.file = './results/pipeline_info/execution_report_2026-10-28_04-38-27.html'
trace.enabled = true
trace.file = './results/pipeline_info/execution_trace_2026-10-28_04-38-27.txt'
dag.enabled = true
dag.file = './results/pipeline_info/pipeline_dag_2026-10-28_04-38-27.svg'
manifest.name = 'nf-core/bactmap'
manifest.author = 'Anthony Underwood'
manifest.homePage = 'https://github.com/nf-core/bactmap'
manifest.description = 'A mapping-based pipeline for creating a phylogeny from bacterial whole genome sequences'
manifest.mainScript = 'main.nf'
manifest.nextflowVersion = '!>=21.04.0'
manifest.version = '1.0.0'
docker.enabled = true
docker.userEmulation = true
singularity.enabled = false
podman.enabled = false
shifter.enabled = false
charliecloud.enabled = false
